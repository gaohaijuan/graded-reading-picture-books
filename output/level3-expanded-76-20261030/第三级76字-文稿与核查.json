  "storyDetails": [
    {
      "number": 1,
      "title": "飞起来的是谁",
      "text": "我用手一拍，气球飞起来了。\n我大声说：“不能落到地上！”\n它飞到左边，我跑到左边。\n它飞到右边，妈妈跑到右边。\n气球落下来了。\n妈妈坐在我身边，一伸脚，又把它顶起来。\n“我也会！”\n我学着妈妈，用力一踢。\n气球没飞，我的鞋飞了！",
      "bodyHanCount": 85,
      "requiredCharacters": [
        "脚",
        "地",
        "坐",
        "学",
        "会",

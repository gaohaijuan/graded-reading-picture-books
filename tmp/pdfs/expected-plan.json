        [
          "小花在雨中。"
        ],
        [
          "小花，来！",
          "小花不来。"
        ],
        [
          "花不来，",
          "我去！"
        ],
        [
          "我在伞下，",
          "小花也在伞下。"
        ],
        [
          "雨在伞上，",
          "伞下有我，也有花。"
        ]
      ]
